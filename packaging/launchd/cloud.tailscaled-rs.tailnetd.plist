<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  cloud.tailscaled-rs.tailnetd.plist — launchd LaunchDaemon for the tailscaled-rs daemon (macOS).

  Runs `tailnetd` as an always-on system daemon (root, started at load / boot). Install to
  /Library/LaunchDaemons and load with `launchctl bootstrap system <plist>` (see ../README.md).

  WARNING: experimental, unaudited software — not for production. See the repository README.

  The EnvironmentVariables dict sets the engine's required experiment opt-in (TS_RS_EXPERIMENT)
  explicitly: loading this daemon IS the operator choosing to run experimental software. The
  daemon deliberately does not set that var for itself. State lives under /usr/local/var/tailnetd
  (the macOS-conventional location for local daemon state); the daemon enforces 0700 on it itself.

  OPERATOR ENVIRONMENT: do NOT add your own keys to the dict below. This file is embedded in the
  tailnetd binary and rewritten verbatim by `tnet install`, so anything you add here is lost on the
  next install. Put operator environment in

      /etc/tailnetd/tailnetd-env.txt

  instead — `KEY=value` lines, `#` comments, blank lines ignored, a double-quoted value unquoted as
  a Go string literal. tailnetd reads it into its own environment before it parses a single flag
  (the analogue of Linux's EnvironmentFile=-/etc/default/tailnetd, and of Go tailscaled's
  tailscaled-env.txt). The file is optional; a malformed one is refused at startup with the line
  number. It is read as root, so own it root:wheel and chmod 0600 it. Example:

      # Hold the SSH server and the port mapper down on this host.
      TS_DISABLE_SSH_SERVER=1
      TS_DISABLE_PORTMAPPER=1
      TAILNETD_LOG=debug
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cloud.tailscaled-rs.tailnetd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tailnetd</string>
    </array>

    <!-- Install-owned: `tnet install` rewrites this file, so operator additions here do not
         survive. Use /etc/tailnetd/tailnetd-env.txt (see the header) for those. -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Required engine opt-in; without it tailnetd refuses to start. -->
        <key>TS_RS_EXPERIMENT</key>
        <string>this_is_unstable_software</string>
        <!-- State dir (node keys + prefs). macOS-conventional /usr/local/var path. -->
        <key>TAILNETD_STATE_DIR</key>
        <string>/usr/local/var/tailnetd</string>
    </dict>

    <!-- Start at load / boot. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on failure only: relaunch if it crashes or exits non-zero, but respect a clean
         `tnet down` + stop (do not fight an intentional exit-0 shutdown). -->
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Logs under /var/log: root-writable and present on every macOS, unlike /usr/local/var/log
         which is absent on Apple-Silicon Homebrew. Created by launchd; rotate via newsyslog if
         desired. (State stays under /usr/local/var/tailnetd above — that is the daemon's
         macOS SYSTEM_STATE_DIR; only the log paths move.) -->
    <key>StandardOutPath</key>
    <string>/var/log/tailnetd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/tailnetd.err.log</string>

    <!-- Long-running background service (not interactive / adaptive). -->
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
